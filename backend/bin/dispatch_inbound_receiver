#!/usr/bin/env ruby
# frozen_string_literal: true

ENV["RAILS_ENV"] ||= "production"

# Ensure .env is loaded
env_file = File.expand_path("../.env", __dir__)
if File.exist?(env_file)
  File.readlines(env_file).each do |line|
    line = line.strip
    next if line.empty? || line.start_with?("#")
    key, val = line.split("=", 2)
    ENV[key] ||= val if key && val
  end
end

require_relative "../config/environment"

raw_email = STDIN.read

if raw_email.present?
  begin
    inbound = ActionMailbox::InboundEmail.create_and_extract_message_id!(raw_email)
    
    # Deliver copy to Dovecot Maildir for Thunderbird / IMAP
    begin
      recipients = [inbound.mail.to, inbound.mail.cc, inbound.mail.header["X-Original-To"]&.value, inbound.mail.header["Delivered-To"]&.value, inbound.mail.header["Envelope-To"]&.value].flatten.compact
      clean_addrs = recipients.map { |a| a.to_s.gsub(/.*<([^>]+)>.*/, '\1').strip.downcase }.reject(&:blank?)
      
      matched_user = User.where("LOWER(email) IN (?)", clean_addrs).first || User.first
      if matched_user
        username = matched_user.email.split("@").first.downcase
        mail_dir = "/home/#{username}/Mail/Inbox/new"
        require "fileutils"
        FileUtils.mkdir_p(mail_dir)
        filename = "#{Time.now.to_i}.#{SecureRandom.hex(8)}.debian"
        filepath = File.join(mail_dir, filename)
        File.write(filepath, raw_email)
        system("chown -R #{username}:mail /home/#{username}/Mail 2>/dev/null")
        system("chmod -R 770 /home/#{username}/Mail 2>/dev/null")
        Rails.logger.info "[Dispatch Inbound Receiver] Delivered IMAP copy to #{filepath}"
      end
    rescue => e
      Rails.logger.warn "Dovecot local delivery warning: #{e.message}"
    end
    
    log_msg = "[#{Time.now.iso8601}] [Dispatch Inbound Receiver] Successfully processed email (ID: #{inbound.id}, Message-ID: #{inbound.message_id})\n"
    Rails.logger.info log_msg.strip
    File.open("/tmp/dispatch-inbound.log", "a") { |f| f.write(log_msg) } rescue nil
  rescue => e
    err_msg = "[#{Time.now.iso8601}] [Dispatch Inbound Receiver Error] #{e.message}\n#{e.backtrace&.join("\n")}\n"
    Rails.logger.error err_msg.strip
    File.open("/tmp/dispatch-inbound.log", "a") { |f| f.write(err_msg) } rescue nil
  end
end

exit 0
